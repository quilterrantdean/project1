#pragma code_page(65001)

1 24 "app.manifest"

#include <windows.h>
#include "resource.h"

IDI_BIBLIOLED ICON "../../port.ico"

IDD_LOAN_DIALOG DIALOG 0, 0, 258, 126
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Empréstimo"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Título:", -1, 8, 10, 40, 10
    EDITTEXT    IDC_LOAN_TITLE, 54, 8, 196, 14, ES_AUTOHSCROLL

    LTEXT       "Tipo:", -1, 8, 31, 40, 10
    COMBOBOX    IDC_LOAN_TYPE, 54, 29, 112, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT       "Data (AAAA-MM-DD):", -1, 8, 53, 85, 10
    EDITTEXT    IDC_LOAN_DATE, 96, 51, 75, 14, ES_AUTOHSCROLL

    LTEXT       "Hora (HH:MM):", -1, 8, 75, 85, 10
    EDITTEXT    IDC_LOAN_TIME, 96, 73, 55, 14, ES_AUTOHSCROLL

    DEFPUSHBUTTON "Guardar", IDOK, 142, 101, 52, 16
    PUSHBUTTON    "Cancelar", IDCANCEL, 198, 101, 52, 16
END

IDD_HISTORY_DIALOG DIALOG 0, 0, 500, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Histórico de empréstimos"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Pesquisar:", -1, 8, 9, 40, 10
    EDITTEXT IDC_HISTORY_SEARCH, 50, 7, 330, 14, ES_AUTOHSCROLL | WS_TABSTOP
    COMBOBOX IDC_HISTORY_TYPE, 388, 6, 104, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_HISTORY_LIST, "SysListView32",
        WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER |
        LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 26, 484, 238
    LTEXT "", IDC_HISTORY_STATUS, 8, 273, 310, 12
    PUSHBUTTON "Editar", IDC_HISTORY_EDIT, 352, 270, 42, 18
    PUSHBUTTON "Eliminar", IDC_HISTORY_DELETE, 400, 270, 48, 18
    DEFPUSHBUTTON "Fechar", IDOK, 456, 270, 36, 18
END

IDD_STATISTICS_DIALOG DIALOG 0, 0, 650, 430
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Estatísticas"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Ano:", -1, 10, 9, 28, 10
    COMBOBOX IDC_STATS_YEAR, 42, 6, 86, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_STATS_TABS, "SysTabControl32",
        WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 28, 634, 356

    LTEXT "", IDC_STATS_TOTAL, 18, 58, 300, 12
    LTEXT "", IDC_STATS_TYPES, 18, 74, 590, 12
    LTEXT "", IDC_STATS_RANGE, 18, 90, 590, 12
    LTEXT "", IDC_STATS_COMPARISON, 18, 106, 610, 12
    LTEXT "", IDC_STATS_INVALID, 18, 122, 590, 12
    CONTROL "", IDC_STATS_ANNUAL, "SysListView32",
        WS_CHILD | WS_VISIBLE | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS,
        16, 143, 616, 229

    LTEXT "Calendário diário (dias com actividade):", IDC_STATS_CALENDAR_LABEL, 18, 58, 245, 12
    LTEXT "Dia da semana:", IDC_STATS_WEEKDAY_LABEL, 286, 58, 150, 12
    LTEXT "Hora:", IDC_STATS_HOUR_LABEL, 458, 58, 150, 12
    CONTROL "", IDC_STATS_DAILY, "SysListView32",
        WS_CHILD | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS,
        16, 78, 258, 278
    CONTROL "", IDC_STATS_WEEKDAYS, "SysListView32",
        WS_CHILD | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS,
        282, 78, 166, 278
    CONTROL "", IDC_STATS_HOURS, "SysListView32",
        WS_CHILD | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS,
        456, 78, 176, 278
    LTEXT "", IDC_STATS_INTERVALS, 18, 362, 610, 14
    DEFPUSHBUTTON "Fechar", IDOK, 576, 395, 56, 18
END

IDD_ABOUT_DIALOG DIALOG 0, 0, 250, 132
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sobre o BiblioLED"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL     "", IDC_ABOUT_ICON, "Static",
                SS_ICON | WS_CHILD | WS_VISIBLE, 10, 12, 32, 32
    LTEXT       "BiblioLED", IDC_ABOUT_NAME, 52, 12, 185, 12
    LTEXT       "Gestor pessoal de empréstimos BiblioLED",
                IDC_ABOUT_DESCRIPTION, 52, 29, 185, 20
    LTEXT       "", IDC_ABOUT_VERSION, 52, 58, 185, 10
    LTEXT       "", IDC_ABOUT_BUILD, 52, 73, 185, 10
    LTEXT       "Alvo: Windows XP SP3 (32 bits)",
                IDC_ABOUT_TARGET, 52, 88, 185, 10
    DEFPUSHBUTTON "Fechar", IDOK, 188, 109, 52, 16
END

IDD_GENERAL_SETTINGS_DIALOG DIALOG 0, 0, 270, 184
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Definições gerais"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Limite diário de empréstimos:", -1, 8, 10, 145, 10
    EDITTEXT    IDC_GENERAL_DAILY_LIMIT, 166, 7, 64, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT       "Limite mensal de empréstimos:", -1, 8, 32, 145, 10
    EDITTEXT    IDC_GENERAL_MONTHLY_LIMIT, 166, 29, 64, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT       "Janela mensal (dias):", -1, 8, 54, 145, 10
    EDITTEXT    IDC_GENERAL_MONTHLY_WINDOW, 166, 51, 64, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT       "Duração do empréstimo (dias):", -1, 8, 76, 145, 10
    EDITTEXT    IDC_GENERAL_LOAN_DURATION, 166, 73, 64, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    AUTOCHECKBOX "Activar registo de actividade local", IDC_GENERAL_DIAGNOSTICS,
                 8, 101, 190, 12, WS_TABSTOP

    LTEXT       "Tamanho máximo do log (KB):", -1, 8, 124, 145, 10
    EDITTEXT    IDC_GENERAL_LOG_SIZE_KB, 166, 121, 64, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    DEFPUSHBUTTON "Guardar", IDOK, 154, 155, 52, 16
    PUSHBUTTON    "Cancelar", IDCANCEL, 210, 155, 52, 16
END

IDD_BACKUP_SETTINGS_DIALOG DIALOG 0, 0, 230, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Definições de cópias de segurança"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Formato de compressão:", -1, 8, 12, 90, 10
    COMBOBOX    IDC_BACKUP_FORMAT, 104, 9, 118, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT       "Nível (0–9):", -1, 8, 36, 90, 10
    COMBOBOX    IDC_BACKUP_LEVEL, 104, 33, 54, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    DEFPUSHBUTTON "Guardar", IDOK, 114, 78, 52, 16
    PUSHBUTTON    "Cancelar", IDCANCEL, 170, 78, 52, 16
END
